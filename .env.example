# copy to .env and fill in — testnet only, NEVER mainnet keys
GRAPH_API_KEY=your_subgraph_studio_key
HEDERA_ACCOUNT_ID=0.0.xxxxxxx
HEDERA_PRIVATE_KEY=0x...
# optional: reuse one HCS receipt topic across restarts (the hub prints a new
# topic id on first run — paste it here and the receipt history survives)
HEDERA_TOPIC_ID=
SEPOLIA_ADDRESS=0x...
# SEPOLIA_PRIVATE_KEY=0x...   # needed only for ENS publishing
ZG_ROUTER_KEY=sk-...            # 0G Compute Router key from pc.0g.ai (needs deposited credits)

# World ID 4.0 — human-verified pricing tier (developer.world.org).
# Until WORLD_RP_ID + WORLD_RP_SIGNING_KEY are set, the hub mints SIMULATED
# sessions (signed, but no human is verified) and every surface labels them
# "simulated". Setting them flips it to fail-closed: a real World ID proof is
# then required before any token is issued.
WORLD_RP_ID=               # rp_xxx — the 4.0 relying-party id
WORLD_APP_ID=              # app_xxx — legacy id, still used by the IDKit widget
WORLD_ACTION=x402-verify   # the action you created in the Developer Portal
WORLD_RP_SIGNING_KEY=      # hex signer key from app creation — SERVER ONLY, never shipped to the browser
WORLD_TOKEN_SECRET=        # shared by hub + gateways to sign session tokens
